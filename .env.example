# Stripe Configuration for MCP Workbench
# Copy this file to .env and fill in your Stripe test API keys

# Get your test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# URLs for checkout redirect
STRIPE_SUCCESS_URL=http://localhost:3000/success
STRIPE_CANCEL_URL=http://localhost:3000/cancel

# Product and Price IDs (populated after running setup)
# Run: python stripe_integration.py --setup to create products and prices
STRIPE_PRODUCT_FREE=
STRIPE_PRODUCT_PRO=
STRIPE_PRODUCT_TEAM=
STRIPE_PRODUCT_ENTERPRISE=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=
