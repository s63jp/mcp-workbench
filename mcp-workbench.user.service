[Unit]
Description=MCP Workbench Server (user service)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/kali/mcp-workbench
Environment=PATH=/home/kali/.hermes/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/kali/mcp-workbench/server.py 3460
Restart=always
RestartSec=5
StandardOutput=append:/home/kali/mcp-workbench/logs/server.log
StandardError=append:/home/kali/mcp-workbench/logs/server_error.log

[Install]
WantedBy=default.target
